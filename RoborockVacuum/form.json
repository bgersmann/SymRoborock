{
    "elements": [
        {
            "type": "ValidationTextBox",
            "name": "DUID",
            "caption": "Device ID (DUID)",
            "width": "350px"
        },
        {
            "type": "Select",
            "name": "Connection",
            "caption": "Connection",
            "options": [
                { "caption": "Local network, cloud as fallback", "value": 0 },
                { "caption": "Cloud only", "value": 1 },
                { "caption": "Local network only", "value": 2 }
            ]
        },
        {
            "type": "ValidationTextBox",
            "name": "Host",
            "caption": "IP address (empty = detect automatically)",
            "validate": "^$|^(10\\.[0-9]{1,3}|192\\.168|172\\.(1[6-9]|2[0-9]|3[01]))\\.[0-9]{1,3}\\.[0-9]{1,3}$"
        },
        {
            "type": "NumberSpinner",
            "name": "UpdateInterval",
            "caption": "Update interval",
            "suffix": "seconds",
            "minimum": 10
        },
        {
            "type": "CheckBox",
            "name": "ShowMap",
            "caption": "Show map (updated during cleaning)"
        },
        {
            "type": "ExpansionPanel",
            "caption": "Cleaning programs",
            "expanded": true,
            "items": [
                {
                    "type": "Label",
                    "caption": "Each program appears as a button in the variable \"Start program\" below the instance."
                },
                {
                    "type": "List",
                    "name": "Programs",
                    "caption": "Programs",
                    "rowCount": 5,
                    "add": true,
                    "delete": true,
                    "changeOrder": true,
                    "columns": [
                        { "caption": "Name", "name": "Name", "width": "170px", "add": "", "edit": { "type": "ValidationTextBox" } },
                        { "caption": "Map", "name": "Map", "width": "140px", "add": -1, "edit": { "type": "Select", "options": [] } },
                        { "caption": "Rooms", "name": "Rooms", "width": "auto", "add": "", "edit": { "type": "ValidationTextBox" } },
                        { "caption": "Cleaning mode", "name": "CleanMode", "width": "170px", "add": -1, "edit": { "type": "Select", "options": [] } },
                        { "caption": "Suction power", "name": "FanPower", "width": "130px", "add": -1, "edit": { "type": "Select", "options": [] } },
                        { "caption": "Water flow", "name": "WaterBoxMode", "width": "130px", "add": -1, "edit": { "type": "Select", "options": [] } },
                        { "caption": "Mop route", "name": "MopMode", "width": "130px", "add": -1, "edit": { "type": "Select", "options": [] } },
                        {
                            "caption": "Passes", "name": "Passes", "width": "100px", "add": 1,
                            "edit": { "type": "Select", "options": [ { "caption": "1x", "value": 1 }, { "caption": "2x", "value": 2 }, { "caption": "3x", "value": 3 } ] }
                        }
                    ]
                },
                {
                    "type": "Label",
                    "name": "ProgramRooms",
                    "caption": ""
                },
                {
                    "type": "Label",
                    "name": "ProgramCheck",
                    "caption": "",
                    "visible": false
                },
                {
                    "type": "CheckBox",
                    "name": "ProgramReturnsHome",
                    "caption": "A program start during a cleaning sends the robot back to the dock (start/stop button)"
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Label",
            "name": "DeviceInfo",
            "caption": ""
        },
        {
            "type": "Button",
            "caption": "Update status",
            "onClick": "if (!RRV_Update($id)) { echo 'Error'; }"
        },
        {
            "type": "Button",
            "caption": "Update rooms",
            "onClick": "echo RRV_UpdateRooms($id);"
        },
        {
            "type": "Button",
            "caption": "Update map",
            "onClick": "RRV_UpdateMap($id);"
        }
    ],
    "status": [
        { "code": 104, "icon": "inactive", "caption": "Please enter the device ID or create the instance via the configurator" },
        { "code": 201, "icon": "error", "caption": "The vacuum is not reachable" },
        { "code": 202, "icon": "error", "caption": "The IP address must be an address of the local network" }
    ]
}
